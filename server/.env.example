# Puerto donde escucha el servidor. El MB360 tiene que apuntar a esta IP y puerto
# (Menú > Comunicación > Servidor en la nube / ADMS).
PORT=4000

# Conexión a MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/cocina

# Clave para firmar los tokens de login. Poné un texto largo y aleatorio.
JWT_SECRET=cambiar-por-un-texto-largo-y-aleatorio

# Zona horaria: el reloj manda la hora local sin zona.
TZ_NAME=America/Argentina/Buenos_Aires
TZ_OFFSET=-03:00
DEVICE_TZ_HOURS=-3

# --- Modo 4370 (conexión directa, el mismo puerto que usa el software de ZKTeco) ---
# IP de los relojes a los que se conecta el servidor ("IP" o "IP:puerto", separados por coma).
# Si está vacío se usa el modo ADMS (el reloj llama al servidor).
RELOJES_4370=
# Cada cuántos segundos se fija si hay fichadas nuevas y ejecuta los comandos pendientes
INTERVALO_4370=5

# Números de serie de equipos permitidos, separados por coma.
# Vacío = acepta cualquier equipo (útil para la primera instalación).
ADMS_SN_PERMITIDOS=

# Si la misma persona ficha dos veces dentro de estos segundos, se ignora la segunda.
DEDUP_SEGUNDOS=60

# Origen del frontend (React) para CORS
CORS_ORIGIN=http://localhost:5173
